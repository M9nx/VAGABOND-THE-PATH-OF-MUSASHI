---
import ChapterNavigation from './ChapterNavigation.astro';
import MobileNavigation from './MobileNavigation.astro';

const currentChapterNumber = '00';
const currentChapterName = 'Introduction';
---

<header class="site-header">
  <nav class="site-nav" aria-label="Main navigation">
    <a class="site-nav__brand" href="#home">
      <span class="site-nav__brand-name">Vagabond</span>
      <span class="site-nav__brand-subtitle">The Path of Musashi</span>
    </a>

    <ChapterNavigation />

    <div class="site-nav__status">
      <p class="site-nav__chapter" id="current-chapter" aria-live="polite" aria-atomic="true">
        <span class="site-nav__chapter-number">{currentChapterNumber}</span>
        <span class="site-nav__chapter-divider" aria-hidden="true">/</span>
        <span class="site-nav__chapter-name">{currentChapterName}</span>
      </p>

      <button
        class="site-nav__menu-button"
        type="button"
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label="Open chapter navigation"
      >
        Menu
      </button>
    </div>
  </nav>

  <MobileNavigation />
</header>
