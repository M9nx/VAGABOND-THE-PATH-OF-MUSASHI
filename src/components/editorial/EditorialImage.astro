---
import { Image } from 'astro:assets';
import type { ChapterImage } from '~/data/chapters';
import ImageCaption from './ImageCaption.astro';

interface Props extends ChapterImage {
  section?: 'light' | 'dark';
}

const {
  src,
  alt,
  number,
  title,
  description,
  variant,
  overlay,
  objectPosition,
  section = 'light',
} = Astro.props;

const overlayClass = overlay ? `editorial-image__overlay editorial-image__overlay--${overlay}` : '';

const sizesByVariant: Record<string, string> = {
  fullscreen: '100vw',
  wide: '(max-width: 640px) 100vw, (max-width: 1200px) 92vw, min(100vw, 100rem)',
  large: '(max-width: 640px) 100vw, (max-width: 1024px) 90vw, 62vw',
  small: '(max-width: 640px) 78vw, (max-width: 1024px) 42vw, 28vw',
  portrait: '(max-width: 640px) 78vw, (max-width: 1024px) 40vw, 30vw',
  landscape: '(max-width: 640px) 100vw, (max-width: 1024px) 55vw, 42vw',
  square: '(max-width: 640px) 100vw, (max-width: 1024px) 45vw, 28vw',
};

const sizes = sizesByVariant[variant] ?? '(max-width: 640px) 100vw, (max-width: 1024px) 80vw, 70vw';
---

<figure class={`editorial-image editorial-image--${variant}`} data-section={section}>
  <div class="editorial-image__wrapper">
    <Image
      src={src}
      alt={alt}
      widths={[400, 800, 1200, 1600, 2000]}
      sizes={sizes}
      style={objectPosition ? `object-position: ${objectPosition};` : undefined}
      loading={variant === 'wide' || variant === 'fullscreen' ? 'eager' : 'lazy'}
      decoding="async"
    />
    {overlay && <div class={overlayClass} aria-hidden="true"></div>}
  </div>

  <ImageCaption number={number} title={title} description={description} />
</figure>

<style>
  .editorial-image__wrapper {
    position: relative;
    overflow: clip;
    isolation: isolate;
    contain: paint;
    width: 100%;
    height: 100%;
  }

  .editorial-image__wrapper :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.08);
  }

  .editorial-image__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .editorial-image__overlay--yellow {
    background: var(--yellow);
    opacity: 0.9;
    mix-blend-mode: multiply;
  }

  .editorial-image__overlay--red {
    background: var(--red);
    opacity: 0.85;
    mix-blend-mode: multiply;
  }

  .editorial-image__overlay--dark {
    background: var(--ink);
    opacity: 0.35;
    mix-blend-mode: multiply;
  }
</style>
