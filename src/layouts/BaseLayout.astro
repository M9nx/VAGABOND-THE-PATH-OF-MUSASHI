---
import '~/styles/reset.css';
import '~/styles/tokens.css';
import '~/styles/typography.css';
import '~/styles/global.css';
import '~/styles/editorial.css';
import '~/styles/motion.css';
import '~/styles/responsive.css';

export interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
}

const {
  title = 'Vagabond — The Path of Musashi',
  description = 'A visual editorial tribute to Miyamoto Musashi from Takehiko Inoue\'s Vagabond.',
  canonicalPath = '/',
} = Astro.props;

const siteOrigin = Astro.site ?? new URL('https://M9nx.github.io');
const base = import.meta.env.BASE_URL;
const normalizedPath = canonicalPath.startsWith('/') ? canonicalPath.slice(1) : canonicalPath;
const canonicalUrl = new URL(`${base}${normalizedPath}`.replace(/\/{2,}/g, '/'), siteOrigin);
const ogImageUrl = new URL(`${base}og-image.jpg`.replace(/\/{2,}/g, '/'), siteOrigin);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>

    <title>{title}</title>

    <link rel="canonical" href={canonicalUrl.href}>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`}>

    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content="website">
    <meta property="og:url" content={canonicalUrl.href}>
    <meta property="og:image" content={ogImageUrl.href}>
    <meta name="theme-color" content="#11110f">

    <slot name="head" />
  </head>

  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <slot />

    <script>
      document.documentElement.classList.add('js');
    </script>
  </body>
</html>
